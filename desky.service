[Unit]
Description=Desky display driver
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/home/hridyesh/display/.venv/bin/python /home/hridyesh/display/main.py
WorkingDirectory=/home/hridyesh/display
Restart=always
RestartSec=5
User=hridyesh
Environment=PYTHONUNBUFFERED=1
# Host-local settings that are not in git and must survive a setup.sh re-run:
# DESKY_BULB_IP above all, which is a fact about this house's LAN, not about the
# code. The leading '-' makes the file optional, so a Pi without one still boots.
# setup.sh creates it once and never overwrites it.
EnvironmentFile=-/etc/desky.env

[Install]
WantedBy=multi-user.target
